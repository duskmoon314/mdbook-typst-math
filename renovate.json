{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Group Typst crates into a single update",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "typst",
        "typst-html",
        "typst-kit",
        "typst-layout",
        "typst-svg"
      ],
      "groupName": "Typst crates"
    }
  ]
}
